<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mongo DB - F1 test</title>
    <link rel="stylesheet" href="../css/style.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

</head>
<!--
  url: String,
  team: teamSchema,
-->

<body>
<body>
    <img src="../images/StarLion.png" alt="lion brewery" />
    <h1>Welcome to my F1 DB</h1>

    <div class="container mt-4">

        <!-- FORM CARD -->
        <div class="card shadow p-4 mb-4">
            <h2 class="mb-3">Driver Information</h2>

            <form action="/driver" method="get" class="row g-3">

                <input type="hidden" name="editing" id="editing" value="false" />
                <input type="hidden" name="driverId" id="driverId" />

                <div class="col-md-2">
                    <input class="form-control" type="text" name="num" id="num" placeholder="Number" />
                </div>

                <div class="col-md-2">
                    <input class="form-control" type="text" name="code" id="code" placeholder="Code" />
                </div>

                <div class="col-md-4">
                    <input class="form-control" type="text" name="name" id="name" placeholder="Name" />
                </div>

                <div class="col-md-4">
                    <input class="form-control" type="text" name="lname" id="lname" placeholder="Last name" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Date of birth</label>
                    <input class="form-control" type="date" name="dob" id="dob" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Biography URL</label>
                    <input class="form-control" type="text" name="url" id="url" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Nationality</label>
                    <select class="form-select" name="nation" id="nation">
                        <% countries.forEach(country => { %>
                            <option value="<%= country.label %>"><%= country.label %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Team</label>
                    <select class="form-select" name="team" id="team">
                        <% teams.forEach(team => { %>
                        <% if (team.name !== "N/A") { %>
                        <option value="<%= team.name %>"><%= team.name %></option>
                        <% } %>
                        <% }); %>
                    </select>
                </div>

                <div class="col-12 mt-3">
                    <button class="btn btn-primary w-100" type="submit">Submit</button>
                </div>

            </form>
        </div>

        <!-- SWITCH -->
        <div class="form-check form-switch mb-4 d-flex align-items-center">
            <input class="form-check-input me-2" type="checkbox" role="switch" id="flexSwitchCheckDefault">
            <label class="form-check-label fs-5" for="flexSwitchCheckDefault" id="toggleLabel">Teams</label>
        </div>

        <!-- DRIVERS TABLE -->
        <div id="drivers" style="display:none;" class="card shadow p-4 mb-4">
            <h3 class="mb-3">Drivers</h3>

            <table class="table table-striped table-hover text-center">
                <thead>
                    <tr>
                        <th>Number</th>
                        <th>Code</th>
                        <th>Forename</th>
                        <th>Surname</th>
                        <th>Date of birth</th>
                        <th>Nationality</th>
                        <th>Biography</th>
                        <th>Team</th>
                        <th>Edit</th>
                    </tr>
                </thead>
                <tbody>
                    <% drivers.forEach(driver => { %>
                    <tr>
                        <td><%= driver.num || "No num" %></td>
                        <td><%= driver.code || "No code" %></td>
                        <td><%= driver.forename || "No forename" %></td>
                        <td><%= driver.surname || "No surname" %></td>
                        <td><%= driver.dob || "No dob" %></td>
                        <td><%= driver.nationality || "No nationality" %></td>

                        <td>
                            <% if (driver.url) { %>
                            <a href="<%= driver.url %>">Biography</a>
                            <% } else { %> No URL <% } %>
                        </td>

                        <td><%= driver.team ? driver.team.name : "No team" %></td>

                        <td>
                            <button 
                                class="edit-btn"
                                data-num="<%= driver.num %>"
                                data-code="<%= driver.code %>"
                                data-forename="<%= driver.forename %>"
                                data-surname="<%= driver.surname %>"
                                data-dob="<%= driver.dob.toISOString().slice(0,10) %>"
                                data-url="<%= driver.url %>"
                                data-nationality="<%= driver.nationality %>"
                                data-team="<%= driver.team ? driver.team.name : '' %>"
                            >Edit</button>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <!-- TEAMS TABLE -->
        <div id="teams" style="display:block;" class="card shadow p-4">
            <h3 class="mb-3">Teams</h3>

            <table class="table table-striped table-hover text-center">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Nationality</th>
                        <th>URL</th>
                    </tr>
                </thead>
                <tbody>
                    <% teams.forEach(team => { %>
                    <% if (team.name !== "N/A") { %>
                    <tr>
                        <td><%= team.id || "No ID" %></td>
                        <td><%= team.name || "No name" %></td>
                        <td><%= team.nationality || "No nationality" %></td>
                        <td>
                            <% if (team.url) { %>
                            <a href="<%= team.url %>">URL</a>
                            <% } else { %> No URL <% } %>
                        </td>
                    </tr>
                    <% } %>
                    <% }); %>
                </tbody>
            </table>
        </div>

    </div>

    <!-- SCRIPTS ORIGINALES NO CAMBIAN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

    <script>

        const toggle = document.getElementById("flexSwitchCheckDefault");
        const Driverscontent = document.getElementById("drivers");
        const Teamscontent = document.getElementById("teams");
        const toggleLabel = document.getElementById("toggleLabel");

        toggle.addEventListener("change", () => {
            if (toggle.checked) {
                Driverscontent.style.display = "block"; 
                Teamscontent.style.display = "none";  
            } else {
                Driverscontent.style.display = "none"; 
                Teamscontent.style.display = "block";  
            }

            toggleLabel.textContent = toggle.checked ? "Drivers" : "Teams";
        });

</script>

<script>

window.addEventListener("load", () => {
    document.getElementById("num").removeAttribute("readonly");
});

const editButtons = document.querySelectorAll(".edit-btn");

editButtons.forEach(btn => {
    btn.addEventListener("click", () => {
        document.getElementById("num").value = btn.dataset.num;
        document.getElementById("code").value = btn.dataset.code;
        document.getElementById("name").value = btn.dataset.forename;
        document.getElementById("lname").value = btn.dataset.surname;
        document.getElementById("dob").value = btn.dataset.dob;
        document.getElementById("url").value = btn.dataset.url;

        const natSelect = document.getElementById("nation");
        const natValue = btn.dataset.nationality?.trim().toLowerCase();

        [...natSelect.options].forEach(opt => {
            if (opt.value.trim().toLowerCase() === natValue) {
                natSelect.value = opt.value;
            }
        });

        const teamSelect = document.getElementById("team");
                const teamValue = btn.dataset.team?.trim().toLowerCase();

                [...teamSelect.options].forEach(opt => {
                    if (opt.value.trim().toLowerCase() === teamValue) {
                        teamSelect.value = opt.value;
                    }
                });

        document.getElementById("num").setAttribute("readonly", true);
        document.getElementById("editing").value = "true";
        document.getElementById("num").scrollIntoView({ behavior: "smooth" });

    });
});

</script>

</body>

</html>